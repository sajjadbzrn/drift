{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "drift",
  "version": "0.4.0",
  "identifier": "com.sajjadbzn.drift",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "drift",
        "width": 1024,
        "height": 740,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "resizable": true,
        "backgroundColor": "#07080d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "drift"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://drift.ir/update/latest.json",
        "https://github.com/sajjadbzrn/drift/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhEQjBDMUNGRjFDRTcyMTkKUldRWmNzN3h6OEd3amNObHlNaUJCa0hrU1ZFaEFqbjVMOVRzN0RBNmFJbno3b0g0VHViandOYWIK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Sajjad Bzn",
    "copyright": "Copyright © 2026 Sajjad Bzn",
    "category": "Utility",
    "shortDescription": "Fast, modern download manager",
    "longDescription": "drift is a modern, minimal download manager for Windows with segmented multi-connection downloads, pause and resume, per-download and global speed limits, clipboard URL detection, and a beautiful dual-theme interface.",
    "licenseFile": "../public/license.txt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
